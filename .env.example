# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string

# --- Admin login (used once by `npm run seed` to create the admin account) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
# After the first successful login, change the password by re-running
# `npm run seed` with a new ADMIN_PASSWORD, or build out a "change password"
# route later.

# --- Email (Gmail SMTP via Nodemailer) ---
# EMAIL_USER must be a real Gmail address. EMAIL_PASS must be a 16-character
# Gmail "App Password" (Google Account -> Security -> 2-Step Verification ->
# App passwords). Your normal Gmail login password will NOT work here.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
# Comma-separated list of addresses that get notified when a new booking
# comes in.
ADMIN_NOTIFY_EMAILS=ankitsriveas080@gmail.com,ashish.raman.iti@gmail.com

# --- WhatsApp click-to-chat (works immediately, no setup) ---
# These are only used to seed the database the very first time the app runs.
# After that, change the phone number, WhatsApp number, Facebook/Instagram
# links, address, and announcement banner from the Site Settings panel in
# /admin/dashboard instead — no restart needed.
BUSINESS_WHATSAPP_NUMBER=919120807102
BUSINESS_PHONE_DISPLAY=+91 91208 07102

# --- WhatsApp Cloud API (optional — only for automated server-sent messages) ---
# Leave these blank if you don't have a Meta WhatsApp Business API account yet.
# The site works fully without them; automated WhatsApp confirmations are
# simply skipped (logged, not sent) until these are filled in.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
